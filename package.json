{
  "name": "keyturn",
  "version": "0.0.0",
  "description": "PostgreSQL refuses an AI agent's write until a person has approved that exact change.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
