{
  "name": "keyturn",
  "version": "0.2.0",
  "description": "PostgreSQL refuses an AI agent's write until a person has approved that exact change.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "keyturn": "./dist/bin.js"
  },
  "files": [
    "dist",
    "sql",
    "review",
    "docs/*.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "pnpm check:secrets && pnpm lint && pnpm typecheck && pnpm test",
    "keyturn": "node src/bin.ts",
    "bench": "node bench/overhead.ts",
    "check:secrets": "scripts/check-secrets.sh --all",
    "prepare": "git config core.hooksPath .githooks || true",
    "demo": "node demo/run.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "playwright": "1.65.1",
    "testcontainers": "12.2.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "ai-agents",
    "human-in-the-loop",
    "approval",
    "audit"
  ]
}
